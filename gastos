from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Border, Side, Alignment
from openpyxl.utils import get_column_letter

# Criar a planilha
wb = Workbook()
ws = wb.active
ws.title = "Controle Financeiro"

# -----------------------------
# TÍTULO
# -----------------------------
ws.merge_cells("A1:F1")
ws["A1"] = "CONTROLE FINANCEIRO DE JOGOS"

ws["A1"].font = Font(
    bold=True,
    italic=True,
    color="FFFFFF",
    size=16
)

ws["A1"].fill = PatternFill(
    "solid",
    fgColor="1F4E78"
)

ws["A1"].alignment = Alignment(
    horizontal="center",
    vertical="center"
)

# -----------------------------
# CABEÇALHOS
# -----------------------------
cabecalhos = [
    "Jogo",
    "Gênero",
    "Preço (R$)",
    "Data da Compra",
    "Forma de Pagamento",
    "Status"
]

for coluna, nome in enumerate(cabecalhos, start=1):
    celula = ws.cell(row=3, column=coluna)
    celula.value = nome

    celula.font = Font(
        bold=True,
        color="FFFFFF"
    )

    celula.fill = PatternFill(
        "solid",
        fgColor="4472C4"
    )

    celula.alignment = Alignment(
        horizontal="center"
    )

# -----------------------------
# DADOS DOS JOGOS
# -----------------------------
dados = [
    ["Resident Evil 4", "Terror", 249.90, "10/09/2026", "Cartão", "Comprado"],
    ["GTA V", "Ação", 99.90, "12/09/2026", "Pix", "Comprado"],
    ["The Witcher 3", "Modo História", 79.90, "15/09/2026", "Cartão", "Comprado"],
    ["Cyberpunk 2077", "Ficção", 149.90, "18/09/2026", "Pix", "Comprado"],
    ["Outlast", "Terror", 49.90, "20/09/2026", "Dinheiro", "Comprado"],
    ["Red Dead Redemption 2", "Ação", 199.90, "22/09/2026", "Cartão", "Comprado"]
]

for linha, dados_linha in enumerate(dados, start=4):
    for coluna, valor in enumerate(dados_linha, start=1):
        ws.cell(row=linha, column=coluna).value = valor

# -----------------------------
# BORDAS
# -----------------------------
borda_fina = Side(
    style="thin",
    color="808080"
)

borda_destaque = Side(
    style="medium",
    color="1F4E78"
)

for linha in ws.iter_rows(
    min_row=3,
    max_row=3 + len(dados),
    min_col=1,
    max_col=6
):
    for celula in linha:
        celula.border = Border(
            left=borda_fina,
            right=borda_fina,
            top=borda_fina,
            bottom=borda_fina
        )

# -----------------------------
# FORMATAÇÃO DOS DADOS
# -----------------------------
for linha in range(4, 4 + len(dados)):

    # Nome do jogo em negrito
    ws.cell(linha, 1).font = Font(
        bold=True,
        color="1F1F1F"
    )

    # Gênero em itálico
    ws.cell(linha, 2).font = Font(
        italic=True,
        color="7030A0"
    )

    # Preço em formato de moeda
    ws.cell(linha, 3).number_format = 'R$ #,##0.00'

    # Centralizar algumas colunas
    for coluna in [2, 4, 5, 6]:
        ws.cell(linha, coluna).alignment = Alignment(
            horizontal="center"
        )

    # Destacar jogos comprados
    ws.cell(linha, 6).fill = PatternFill(
        "solid",
        fgColor="C6EFCE"
    )

    ws.cell(linha, 6).font = Font(
        bold=True,
        color="006100"
    )

# -----------------------------
# TOTAL GASTO
# -----------------------------
linha_total = 4 + len(dados)

ws.cell(linha_total, 1).value = "TOTAL GASTO"
ws.cell(linha_total, 1).font = Font(
    bold=True,
    color="FFFFFF"
)

ws.cell(linha_total, 1).fill = PatternFill(
    "solid",
    fgColor="C00000"
)

ws.cell(linha_total, 3).value = f"=SUM(C4:C{linha_total - 1})"
ws.cell(linha_total, 3).number_format = 'R$ #,##0.00'

ws.cell(linha_total, 3).font = Font(
    bold=True,
    color="FFFFFF"
)

ws.cell(linha_total, 3).fill = PatternFill(
    "solid",
    fgColor="C00000"
)

# Borda mais forte no total
for coluna in range(1, 7):
    ws.cell(linha_total, coluna).border = Border(
        top=borda_destaque,
        bottom=borda_destaque,
        left=borda_fina,
        right=borda_fina
    )

# -----------------------------
# AJUSTAR TAMANHO DAS COLUNAS
# -----------------------------
larguras = [25, 18, 15, 18, 22, 15]

for i, largura in enumerate(larguras, start=1):
    ws.column_dimensions[get_column_letter(i)].width = largura

# Altura do título
ws.row_dimensions[1].height = 30

# Congelar o cabeçalho
ws.freeze_panes = "A4"

# -----------------------------
# SALVAR ARQUIVO
# -----------------------------
wb.save("controle_financeiro_jogos.xlsx")

print("Planilha criada com sucesso!")
